    print("\n[SCENARIO 2] Testing Engineering Operations...")
    rbac.validate_access(username='staff_user', required_permission='WRITE_DATA')
    
    print("\n[SCENARIO 3] Testing Malicious Privilege Escalation Trajectory...")
