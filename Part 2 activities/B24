cat << 'EOF' > rbac_engine.py
import datetime

class RoleBasedAccessControl:
    def __init__(self):
        self.ROLE_PERMISSIONS = {
            'Admin':     ['READ_DATA', 'WRITE_DATA', 'DELETE_DATA', 'PURGE_LOGS'],
            'Engineer':  ['READ_DATA', 'WRITE_DATA'],
            'Guest':     ['READ_DATA']
        }
        self.USER_ROLES = {
            'joshua': 'Admin',
            'staff_user': 'Engineer',
            'anonymous_guest': 'Guest'
        }

    def validate_access(self, username, required_permission):
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        if username not in self.USER_ROLES:
            print(f"[{timestamp}] [ACCESS-DENIED] Identity '{username}' not found in registry. Dropping packet.")
            return False
            
        assigned_role = self.USER_ROLES[username]
        allowed_permissions = self.ROLE_PERMISSIONS.get(assigned_role, [])
        
        if required_permission in allowed_permissions:
            print(f"[{timestamp}] [ACCESS-GRANTED] User '{username}' [Role: {assigned_role}] authorized for action: '{required_permission}'.")
            return True
        else:
            print(f"[{timestamp}] [ACCESS-DENIED] User '{username}' [Role: {assigned_role}] lacks explicit permission: '{required_permission}' (CWE-285).")
            return False

if __name__ == "__main__":
    print("[INIT] RBAC Identity Gateway Active. Authorization matrix armed.")
EOF

