    print("\n[SCENARIO 4] Testing Rogue Foreign Identity Entry...")
    rbac.validate_access(username='unknown_attacker', required_permission='READ_DATA')
    
    print("======================================================================")

if __name__ == "__main__":
    run_rbac_test_suite()
EOF

