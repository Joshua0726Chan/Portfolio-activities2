# Instead of allowing access based only on login (Authentication),
# we enforce Authorization by checking an ACL[cite: 15].

class SecureSystem:
    def __init__(self):
        # The ACL table maps Subjects to Objects and their permitted actions [cite: 15]
        self.acl = {
            'alice': {'file1.txt': 'read', 'file2.txt': 'write'},
            'bob':   {'file1.txt': 'read'}
        }

    def access_resource(self, user, resource, action):
        # 1. Authentication happens before this point (User is verified)
        
        # 2. Enforcement Mechanism: Check if user has explicit permission [cite: 4, 91]
        user_permissions = self.acl.get(user, {})
        allowed_action = user_permissions.get(resource)
        
        if allowed_action == action:
            return f"ACCESS GRANTED: {user} performed {action} on {resource}."
        else:
            # Policy Enforcement: Deny if not explicitly allowed [cite: 83]
            return f"ACCESS DENIED: {user} is not authorized to {action} {resource}."

# --- Usage ---
