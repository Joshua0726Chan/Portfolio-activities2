#!/usr/bin/env bash

# =========================================================
# CVE-2026-46333 Mitigation & Kernel Patch Automation
# Supports:
#   - Ubuntu / Debian
#   - Fedora
#   - RHEL / Rocky / AlmaLinux / CentOS Stream
#   - Arch Linux
#
# What this script does:
#   1. Detects Linux distribution
#   2. Applies ptrace mitigation
#   3. Updates the kernel
#   4. Cleans package cache
#   5. Verifies protection settings
#
# Run as root:
#   sudo bash fix-cve-2026-46333.sh
# =========================================================

set -e

echo "========================================="
echo " CVE-2026-46333 Auto Mitigation Script"
echo "========================================="
echo ""

# ---------------------------------------------------------
# Ensure script is running as root
# ---------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
    echo "[ERROR] Please run this script as root."
    echo "Use: sudo bash $0"
    exit 1
fi

# ---------------------------------------------------------
# Detect distro
# ---------------------------------------------------------

if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    DISTRO=$ID
else
    echo "[ERROR] Cannot detect Linux distribution."
    exit 1
fi

echo "[INFO] Detected distribution: $DISTRO"
echo ""

# ---------------------------------------------------------
# Step 1: Apply temporary mitigation
# ---------------------------------------------------------

echo "[STEP 1] Applying ptrace mitigation..."

sysctl -w kernel.yama.ptrace_scope=2

cat > /etc/sysctl.d/99-cve-2026-46333.conf <<EOF
kernel.yama.ptrace_scope = 2
EOF

sysctl --system > /dev/null

echo "[OK] ptrace mitigation enabled."
echo ""

# ---------------------------------------------------------
# Step 2: Update kernel depending on distro
# ---------------------------------------------------------

echo "[STEP 2] Updating system kernel..."

case "$DISTRO" in

    ubuntu|debian)
        apt update
        apt -y full-upgrade
        ;;

    fedora)
        dnf -y upgrade kernel
        ;;

    rhel|rocky|almalinux|centos|centos_stream)
        dnf -y update kernel
        ;;

    arch)
        pacman -Syu --noconfirm
        ;;

    *)
        echo "[WARNING] Unsupported distribution."
        echo "Please update your kernel manually."
        ;;
esac

echo "[OK] Kernel update completed."
echo ""

# ---------------------------------------------------------
# Step 3: Cleanup package cache
# ---------------------------------------------------------

echo "[STEP 3] Cleaning package cache..."

case "$DISTRO" in

    ubuntu|debian)
        apt autoremove -y
        apt clean
        ;;

    fedora|rhel|rocky|almalinux|centos|centos_stream)
        dnf clean all
        ;;

    arch)
        pacman -Sc --noconfirm
        ;;
esac

echo "[OK] Cleanup complete."
echo ""

# ---------------------------------------------------------
# Step 4: Verification
# ---------------------------------------------------------

echo "[STEP 4] Verifying system protection..."

echo ""
echo "Current kernel:"
uname -r

echo ""
echo "ptrace setting:"
sysctl kernel.yama.ptrace_scope

echo ""

if sysctl kernel.yama.ptrace_scope | grep -q "= 2"; then
    echo "[OK] ptrace mitigation is active."
else
    echo "[WARNING] ptrace mitigation may not be active."
fi

echo ""
echo "========================================="
echo " Mitigation completed successfully"
echo "========================================="
echo ""
echo "IMPORTANT:"
echo "Reboot the system to load the patched kernel."
echo ""
echo "Reboot command:"
echo "sudo reboot"
echo ""


