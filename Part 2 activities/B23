import re
import datetime

class HostIntrusionDetectionSystem:
    def __init__(self, threshold_failed_logins=3):
        self.THRESHOLD_FAILED_LOGINS = threshold_failed_logins
        # In-memory database tracking transient operational threat metrics
        self.failed_login_counters = {}

    def analyze_log_line(self, log_entry):
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        # Brute-Force Login Detection Engine (CWE-307)
        if "FAILED LOGIN" in log_entry:
            user_match = re.search(r"user='([^']+)'", log_entry)
            if user_match:
                username = user_match.group(1)
                self.failed_login_counters[username] = self.failed_login_counters.get(username, 0) + 1
                
                print(f"[{timestamp}] [IDS-INFO] Failed login attempt logged for user: '{username}' (Count: {self.failed_login_counters[username]})")
                
                # Assess threshold violations
                if self.failed_login_counters[username] >= self.THRESHOLD_FAILED_LOGINS:
                    print(f"[{timestamp}] [CRITICAL-ALERT-IDS] Brute-Force Exploit Target Locked! User '{username}' surpassed threshold limit.")
                    return "ALERT_BRUTE_FORCE"

        # SQL Injection Ingress Probe Detection (CWE-89)
        if any(payload in log_entry.upper() for payload in ["UNION SELECT", "OR 1=1", "' OR ''='"]):
            print(f"[{timestamp}] [CRITICAL-ALERT-IDS] SQL Injection Malicious Payload Pattern Intercepted inside API stream!")
            return "ALERT_SQLI"

        return "STATUS_NORMAL"

if __name__ == "__main__":
    print("[INIT] Active Monitoring Perimeter Online. HIDS Kernel Armed.")







